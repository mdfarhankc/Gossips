# Copy this to .env and fill in.
# (Or to a different name like .env.prod-local and run with DOTENV_FILE=.env.prod-local)

# ── Required ──
# Generate with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-real-50-char-random-string

# ── Mode ──
# True  → SQLite, InMemory channels, no SSL hardening (typical dev).
# False → must set ALLOWED_HOSTS; use Postgres + Redis; enables prod hardening.
DEBUG=True

# ── Allowed hosts ──
# Required when DEBUG=False. Comma-separated.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# ── Database ──
# Leave unset to fall back to local db.sqlite3 (fine for dev).
# Set to a postgres URL for prod-mode testing or real prod:
# DATABASE_URL=postgres://gossips:gossips@localhost:5432/gossips

# ── Channel layer ──
# Leave unset to use InMemoryChannelLayer (single Daphne process only).
# Required for multi-worker / prod:
# REDIS_URL=redis://localhost:6379/0

# ── HTTPS hardening ──
# Off by default so local prod testing without TLS doesn't redirect-loop.
# Set to True only when there's a real HTTPS reverse proxy in front (Fly, Render, nginx + certbot, etc.).
# SECURE_SSL_ENABLED=True
